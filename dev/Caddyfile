# Dev reverse proxy: one origin (http://localhost:8085) for the API, uploads and the web dev server.
{
	auto_https off
	servers {
		max_header_size 25MB
	}
}

:80 {
	request_body {
		max_size {$FILE_SIZE_LIMIT:5242880}
	}
	reverse_proxy /api/* api:8000
	reverse_proxy /auth/* api:8000
	reverse_proxy /static/* api:8000
	reverse_proxy /{$BUCKET_NAME:uploads}/* plane-minio:9000
	reverse_proxy /{$BUCKET_NAME:uploads} plane-minio:9000
	# the web app (vite) runs on the host with `pnpm dev`
	reverse_proxy /* host.docker.internal:3000
}
